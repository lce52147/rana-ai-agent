{
  "schema": "rana.lore.manifest.v4",
  "canonicalAliasOverrides": "LORE/canonical_aliases.json",
  "nativeRuntime": [
    "AGENTS.md",
    "SOUL.md",
    "TOOLS.md",
    "IDENTITY.md",
    "USER.md",
    "HEARTBEAT.md",
    "MEMORY.md"
  ],
  "bootstrapRole": "absent after initialization; not a runtime persona source",
  "programmaticRuntime": [
    "LORE/runtime/06_Rana_Character_Impressions.json"
  ],
  "visionOnly": [
    "LORE/runtime/07_Rana_Vision_Identity.json"
  ],
  "retrievalOnly": [
    "LORE/research/10_Rana_ThirdPerson_Lore.md",
    "LORE/research/11_Rana_Relationship_Map_Full.md",
    "LORE/research/11_Rana_Remembered_People_Evidence.md",
    "LORE/research/12_Rana_Interaction_Index.md",
    "LORE/research/13_Rana_Game_Story_Index.md",
    "LORE/research/14_Rana_Speech_Style_Corpus.md",
    "LORE/research/15_Rana_MaigoShukai_Index.md",
    "LORE/research/16_Rana_Source_Audit.md",
    "LORE/research/17_Rana_Official_Small_Theater_Index.md",
    "LORE/research/18_Coverage_Report.md",
    "LORE/runtime/identity_events/haruhikage.md"
  ],
  "excluded": [
    "LORE/deployment/**",
    "LORE/archive_notes/**",
    "workspace/memory/**",
    "docs/**",
    "project_brain/**"
  ],
  "retrievalBuild": {
    "namespace": "canonical_lore",
    "embeddingProvider": "ollama",
    "embeddingModel": "qwen3-embedding:0.6b",
    "embeddingFallback": "none",
    "chunking": "semantic_headings",
    "lexicalCandidates": [
      "unicode61",
      "trigram"
    ],
    "policy": "manifest_exact_files_only"
  },
  "runtimeFactAuthority": "LORE/runtime/06_Rana_Character_Impressions.json",
  "runtimeFactAuthorityScope": [
    "characters",
    "relationships",
    "events",
    "places",
    "temporal_state",
    "descriptors",
    "knowledge_boundaries"
  ],
  "coreScope": [
    "persona",
    "speech_style",
    "stable_self_identity",
    "user_preferences",
    "tool_policy",
    "long_term_user_memory"
  ],
  "researchRole": "provenance_and_source_lookup_only",
  "ordinaryCharacterQuestions": "structured_runtime_facts_first",
  "retrievalRuntimeAuthority": "current_manifest_selected_source_files",
  "generatedRagRole": "build_artifact_not_runtime_authority_when_dirty_or_stale"
}
